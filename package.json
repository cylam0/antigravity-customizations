{
  "name": "antigravity-customizations",
  "version": "1.0.0",
  "description": "Collection of plugins, UI extensions, and skills for Google Antigravity.",
  "type": "module",
  "private": true,
  "scripts": {
    "deploy": "powershell -ExecutionPolicy Bypass -File ./sync.ps1",
    "pull": "powershell -ExecutionPolicy Bypass -File ./sync.ps1 -FromAntigravity",
    "sync": "npm run deploy",
    "check": "node --check plugins/skills-manager/sidecars/panel/main.mjs && node scripts/validate-customizations.mjs",
    "test": "npm run check"
  },
  "keywords": [
    "antigravity",
    "skills",
    "plugins",
    "extensions"
  ],
  "author": "cylam0",
  "license": "MIT"
}
